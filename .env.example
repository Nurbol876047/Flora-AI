# Скопируйте этот файл в .env.local и заполните своими ключами.
# .env.local никогда не коммитится и не попадает во фронтенд —
# ключи используются только в серверном маршруте src/app/api/identify/route.js

# Ключ OpenAI (https://platform.openai.com/api-keys). Обязателен —
# используется для анализа фото (vision) и формирования карточки вида.
OPENAI_API_KEY=

# Модель OpenAI с поддержкой изображений. По умолчанию используется
# экономичная gpt-4o-mini; для более точных описаний можно указать gpt-4o.
OPENAI_MODEL=gpt-4o-mini

# Ключ Pl@ntNet (https://my.plantnet.org/ -> "Get an API key", бесплатно
# для некоммерческого/учебного использования). Если не указан —
# приложение автоматически переходит в запасной режим (только LLM).
PLANTNET_API_KEY=
